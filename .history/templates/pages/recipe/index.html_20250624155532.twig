{% extends 'base.html.twig' %}

{% block title %}Liste des recettes
{% endblock %}

{% block body %}
	<div class="container mt-4">
		{% if not recipes.items is same as([]) %}
			<h1>Mes recettes</h1>
			<div class="count mt-4">
				<h4>Il y a {{ recipes.getTotalItemCount() }} recettes</h4>
			</div>
			<table class="table table-striped">
				<thead>
					<tr>
						<th>#</th>
						<th>Nom</th>
						<th>Description</th>
						<th>Créée le</th>
						<th>Favori</th>
						<th>Temps</th>
						<th>Personnes</th>
						<th>Difficulté</th>
						<th>Prix</th>
						<th>Modifiée le</th>
						<th>Actions</th>
					</tr>
				</thead>
				<tbody>
					{% for recipe in recipes %}
						<tr class="table-primary">
                        <th scope="row">{{ recipe.id }}</th>
							<td>{{ recipe.name }}</td>
							<td>{{ recipe.description|length > 50 ? recipe.description|slice(0, 50) ~ '...' : recipe.description }}</td>
							<td>{{ recipe.createdAt ? recipe.createdAt|date('Y-m-d') : '' }}</td>
							<td>{{ recipe.isFavorite ? 'Oui' : 'Non' }}</td>
							<td>{{ recipe.time ? recipe.time ~ ' min' : '' }}</td>
							<td>{{ recipe.nbPeople ?? '-' }}</td>
							<td>{{ recipe.difficulty ?? '-' }}</td>
							<td>{{ recipe.price is not null ? recipe.price ~ ' €' : '-' }}</td>
							<td>{{ recipe.updatedAt ? recipe.updatedAt|date('Y-m-d') : '' }}</td>
							<td>
							</td>
						</tr>
					{% else %}
						<tr>
							<td colspan="11" class="text-center">Aucune recette trouvée.</td>
						</tr>
					{% endfor %}
				</tbody>
			</table>

			<a href="{{ path('app_recipe_new') }}" class="btn btn-success">Créer une nouvelle recette</a>
