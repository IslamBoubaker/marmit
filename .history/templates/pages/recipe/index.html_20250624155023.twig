{% extends 'base.html.twig' %}

{% block title %}Liste des recettes{% endblock %}

{% block body %}
    <div class="mt-4"

    <table class="table table-striped">
        <thead>
            <tr>
                <th>#</th>
                <th>Nom</th>
                <th>Description</th>
                <th>Créée le</th>
                <th>Favori</th>
                <th>Temps</th>
                <th>Personnes</th>
                <th>Difficulté</th>
                <th>Prix</th>
                <th>Modifiée le</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
        {% for recipe in recipes %}
            <tr>
                <td>{{ recipe.id }}</td>
                <td>{{ recipe.name }}</td>
                <td>{{ recipe.description|length > 50 ? recipe.description|slice(0, 50) ~ '...' : recipe.description }}</td>
                <td>{{ recipe.createdAt ? recipe.createdAt|date('Y-m-d') : '' }}</td>
                <td>{{ recipe.isFavorite ? 'Oui' : 'Non' }}</td>
                <td>{{ recipe.time ? recipe.time ~ ' min' : '' }}</td>
                <td>{{ recipe.nbPeople ?? '-' }}</td>
                <td>{{ recipe.difficulty ?? '-' }}</td>
                <td>{{ recipe.price is not null ? recipe.price ~ ' €' : '-' }}</td>
                <td>{{ recipe.updatedAt ? recipe.updatedAt|date('Y-m-d') : '' }}</td>
                <td>
                    <a href="{{ path('app_recipe_show', {'id': recipe.id}) }}" class="btn btn-sm btn-primary">Voir</a>
                    <a href="{{ path('app_recipe_edit', {'id': recipe.id}) }}" class="btn btn-sm btn-warning">Modifier</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="11" class="text-center">Aucune recette trouvée.</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <a href="{{ path('app_recipe_new') }}" class="btn btn-success">Créer une nouvelle recette</a>
{% endblock %}
