{% extends 'base.html.twig' %}


{% block body %}
	<div class="container">
		<h1 class="mt-4">Creation d'un ingredient</h1>
		{{ form_start(form) }}
<div class="my-cutom-class-for-errors" >
		{{ form_errors(form) }}
</div>

<div class="row">
        <div class="col">
		{{ form_row(form.task) }}
        </div>
        <div class="col" id ="some-custom-id">
		{{ form_row(form.dueDate) }}
        </div>

		{{ form_row(form.submit, { 'label': 'Submit me' }) }}
		{{ form_end(form) }}


	{% endblock %}
