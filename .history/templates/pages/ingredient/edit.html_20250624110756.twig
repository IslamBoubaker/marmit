{% extends 'base.html.twig' %}


{% block content %}
    <h1 class="mt-4">Modification de l'Ingredient</h1>

    {{ form_start(form) }}
    <div class="form-group">
        {{ form_label(form.name) }}
        {{ form_widget(form.name) }}
        <div
        
    
        {{ form_row(form.name) }}
        {{ form_row(form.description) }}
        {{ form_row(form.save) }}
    {{ form_end(form) }}

    <a href="{{ path('ingredient_list') }}">Back to list</a>
{% endblock %}