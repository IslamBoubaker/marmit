{% extends 'base.html.twig' %}

{% block title %}Hello IngredientController!
{% endblock %}

{% block body %}
<div class="container mt-4">
 {% if not ingredients.items is same as ([]) %}
    <h1>Mes ingredients</h1>
    <a href="{{ path('app_ingredient_new') }}" class="btn btn-primary mt-4">Ajouter un ingredient</a>
    <div class="count">
    <h4>Il y a {{ ingredients.getTotalItemCount}} ingredients</h4>
    </div>
    <table class="table table-hover">
        <thead>
   <tr class="table-dark">
      <th scope="row"><font style="vertical-align: inherit;"><font style="vertical-align: inherit;">Numero</font></font></th>
      <td><font style="vertical-align: inherit;"><font style="vertical-align: inherit;">Nom</font></font></td>
      <td><font style="vertical-align: inherit;"><font style="vertical-align: inherit;">Prix</font></font></td>
      <td><font style="vertical-align: inherit;"><font style="vertical-align: inherit;">Date de creation</font></font></td>
    </tr>
</thead>
<tbody>
    {% for ingredient in ingredients %}
    <tr class="table-success">

        <th scope="row">{{ ingredient.id }}</th>
        <td>{{ ingredient.name }}</td>
        <td>{{ ingredient.price }}</td>
        <td>{{ ingredient.createdAt|date('Y-m-d') }}</td>
        <td>
            <a href="{{ path('app_ingredient_show', { id: ingredient.id }) }}" class="btn btn-primary">Voir</a>
        <a href="{{ path('app_ingredient_edit', { id: ingredient.id }) }}" class="btn btn-info">Modifier</a>
    </tr>
    {% endfor %}
</tbody>
</table>
		<div class="navigation d-flex justify-content-center">
			{{ knp_pagination_render(ingredients) }}
		</div>
{% else %}
    <h1>Il n'y a pas d'ingredients</h1>
    {% endif %}

