{% extends 'base.html.twig' %}


{% block body %}
	<div class="container">
		<h1 class="mt-4">Creation d'un ingredient</h1>
		{{ form_start(form) }}
		<div class="form-group">
			{{ form_label(form.name) }}
			{{ form_widget(form.name) }}
		

		<div class="form-error">
		
				{{ form_row(form.task) }}
			</div>
			<div class="col" id="some-custom-id">
				{{ form_row(form.dueDate) }}
			</div>
		</div>

		{{ form_end(form) }}

	</div>

{% endblock %}
